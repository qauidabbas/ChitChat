# Used by docker-compose.yml. Service secrets (JWT_TOKEN, Cloudinary, Gmail) go in backend/*/.env.
RABBITMQ_USERNAME=chitchat
RABBITMQ_PASSWORD=change_me
# Public deployment (docker-compose.prod.yml): your domain, pointed at this server
DOMAIN=chitchat.example.com
# Optional: use hosted MongoDB/Redis instead of the bundled containers
# MONGO_URI=
# REDIS_URL=
# Optional overrides for local runs without docker-compose.prod.yml (browser-facing URLs)
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_USER_SERVICE=http://localhost:5000
# NEXT_PUBLIC_CHAT_SERVICE=http://localhost:5002
