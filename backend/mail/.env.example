PORT=5001
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_16_character_google_app_password
# Optional: full broker URL (e.g. CloudAMQP amqps://...), overrides RABBITMQ_HOST/USERNAME/PASSWORD
# RABBITMQ_URL=
# Optional: send via Brevo HTTPS API instead of Gmail SMTP (for hosts that block SMTP)
# BREVO_API_KEY=
# Sender address (defaults to MAIL_USER); must be a verified Brevo sender when using Brevo
# MAIL_FROM=
